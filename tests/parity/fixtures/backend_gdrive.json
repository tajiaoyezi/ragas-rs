{
  "feature": "backend::gdrive",
  "python_baseline": {
    "upstream_module": "src/ragas/backends/gdrive_backend.py",
    "storage_model": "Google Drive spreadsheets",
    "dataset_sheet_suffix": ".gsheet",
    "folders": [
      "datasets",
      "experiments"
    ],
    "scopes": [
      "https://www.googleapis.com/auth/drive",
      "https://www.googleapis.com/auth/spreadsheets"
    ],
    "auth_modes": [
      "service-account",
      "oauth"
    ],
    "token_default": "token.json"
  },
  "rust_output": {
    "implementation": "GoogleDriveDatasetBackend<InMemoryGoogleSheetTransport>",
    "default_ci_transport": "deterministic in-memory Google Sheets rows",
    "operations": [
      "save",
      "load",
      "list",
      "delete"
    ],
    "header_policy": "sorted sheet headers",
    "nested_value_policy": "JSON encoded retrieved_contexts",
    "live_google_api": "out-of-scope for default CI"
  },
  "tolerance": null
}
