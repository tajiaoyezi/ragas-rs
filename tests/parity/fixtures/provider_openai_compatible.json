{
  "feature": "provider::openai-compatible",
  "python_baseline": {
    "upstream_modules": [
      "src/ragas/llms/base.py",
      "src/ragas/embeddings/openai_provider.py"
    ],
    "auth_env": "OPENAI_API_KEY",
    "llm_path": "/chat/completions",
    "embedding_path": "/embeddings",
    "response_text_path": "choices[0].message.content",
    "usage_path": "usage"
  },
  "rust_output": {
    "contract": "ProviderProtocolDescriptor + ProviderRequestPlan",
    "default_ci_mode": "deterministic request planning",
    "auth_header": "Bearer <redacted>",
    "system_prompt": true,
    "live_network": "opt-in only"
  },
  "tolerance": null
}
