# ragas-rs provider configuration — copy this file to `.env` and fill in your keys.
#
#   cp .env.example .env      # (PowerShell: Copy-Item .env.example .env)
#
# Resolution order for every value: real environment variable > .env file > built-in default.
# A value here never overrides a variable already set in your real shell environment.
# Verify what the library resolves with:  cargo run --example show_config

# --- Chat model (required for any LLM-based metric, testset generation, or the CLI) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-pro

# --- Embeddings (only needed for AnswerRelevancy). May be a DIFFERENT provider. ---
# Leave these blank to reuse the chat key/base_url above. DeepSeek has no embeddings
# endpoint, so the example below pairs DeepSeek chat with SiliconFlow embeddings.
OPENAI_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
