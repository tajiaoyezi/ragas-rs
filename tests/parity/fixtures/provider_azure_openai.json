{
  "feature": "provider::azure-openai",
  "python_baseline": {
    "upstream_modules": [
      "src/ragas/llms/base.py",
      "src/ragas/embeddings/openai_provider.py"
    ],
    "auth_env": "AZURE_OPENAI_API_KEY",
    "llm_path": "/openai/deployments/{deployment}/chat/completions",
    "embedding_path": "/openai/deployments/{deployment}/embeddings",
    "api_version": "required",
    "usage_path": "usage"
  },
  "rust_output": {
    "contract": "ProviderProtocolDescriptor + ProviderRequestPlan",
    "default_ci_mode": "deterministic request planning",
    "auth_header": "api-key: <redacted>",
    "deployment_mapping": "model maps to deployment in default plan",
    "live_network": "opt-in only"
  },
  "tolerance": null
}
